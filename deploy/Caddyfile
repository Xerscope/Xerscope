# Behind Tailscale Funnel: TLS is terminated by tailscaled, Caddy only authenticates and
# proxies, on a port that exists solely inside the shared container network namespace.
# XERSCOPE_PATH is the secret URL prefix (no slashes): the app lives at /<prefix>/, every
# other path answers 404 before authentication. Scanners find every *.ts.net name within
# seconds from the public certificate logs; the prefix keeps them off the login prompt.
{
    admin off
    auto_https off
    default_bind 127.0.0.1
    log {                                       # default logger: proxy errors (http.log.error.*) print the
        format filter {                         # request too; the site's log block filters access logs only
            wrap json
            request>uri replace REDACTED
            request>headers>Referer delete
        }
    }
    servers {
        trusted_proxies static private_ranges   # tailscaled proxies from 127.0.0.1: log the visitor's IP
    }
}

:8080 {   # no host here: a host in the site address also filters the Host header
    redir /{$XERSCOPE_PATH} /{$XERSCOPE_PATH}/ 308   # the page's relative asset URLs need the trailing slash
    handle_path /{$XERSCOPE_PATH}/* {              # strips the prefix: Streamlit keeps serving "/"
        basic_auth {
            {$XERSCOPE_USER} {$XERSCOPE_PASSWORD_HASH}
        }
        reverse_proxy app:8501    # network alias: "xerscope" is tailscale's hostname here
    }
    handle {
        respond 404
    }
    log {
        output stdout
        format filter {
            wrap console
            request>headers>Referer delete   # the Referer holds the full URL, i.e. the secret prefix
            request>uri replace REDACTED     # so does the request line
            resp_headers>Location delete     # and the redirect to the trailing slash
        }
    }
}
