# TLS in front of the language model (deploy/compose.yaml `llm-tls`, profile llm). The stock
# llama.cpp server image carries no SSL: the model listens on 127.0.0.1:8080 of the namespace
# this Caddy shares, and this Caddy is the only thing on the model's fixed address, over TLS
# with a certificate made once on the NAS (docs/deploy.md §10) and mounted read-only, so this
# container runs rootless and writes nothing. The app trusts that certificate alone
# (XERSCOPE_QUERY_CA) and sends the model's key on every request; the model checks the key.
{
    admin off
    auto_https off                                  # no ACME, no redirects: the certificate is given
    default_bind 172.29.0.20
    log {
        format filter {
            wrap json
            request>headers>Authorization delete     # the key never reaches a log
        }
    }
}

https://172.29.0.20:8443 {
    tls /certs/llm.crt /certs/llm.key
    header {
        -Server
        Cache-Control "no-store"
    }
    reverse_proxy 127.0.0.1:8080
}
