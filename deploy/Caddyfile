# Behind Tailscale Funnel: TLS is terminated by tailscaled, Caddy only authenticates and
# proxies, on a port that exists solely inside the shared container network namespace.
{
    admin off
    auto_https off
    default_bind 127.0.0.1
    servers {
        trusted_proxies static private_ranges   # tailscaled proxies from 127.0.0.1: log the visitor's IP
    }
}

:8080 {   # no host here: a host in the site address also filters the Host header
    basic_auth {
        {$XERSCOPE_USER} {$XERSCOPE_PASSWORD_HASH}
    }
    reverse_proxy xerscope:8501
    log {
        output stdout
        format filter {
            wrap console
            request>headers>Referer delete   # the Referer holds the full URL, i.e. the secret prefix
        }
    }
}
