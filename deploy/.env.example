# deploy/compose.yaml: copy to .env next to it, on a PC as on the NAS (Container Manager reads it too)
TS_AUTHKEY=tskey-auth-...            # Tailscale admin > Settings > Keys: single-use, tag:xerscope; first start only, then delete
XERSCOPE_USER=<login>
XERSCOPE_PASSWORD_HASH='$2a$10$...'   # quotes keep the $ signs; docker run --rm caddy:2.11.8 caddy hash-password --algorithm bcrypt --bcrypt-cost 10 --plaintext '...'
XERSCOPE_PATH=<random>               # openssl rand -hex 12; the app answers at /<random>/ only
XERSCOPE_EXPORTS=../exports          # NAS: /volume1/<shared-folder>, readable by the XERSCOPE_UID account only
# XERSCOPE_UID=<uid>                 # NAS: id <dedicated DSM account>, e.g. uid=1028; default 65532
# XERSCOPE_GID=<gid>                 # NAS: its gid (100 = users); default 65532
# XERSCOPE_IMAGE=<docker-hub-login>/xerscope:sha-<short>   # optional: the Docker Hub copy instead of ghcr.io, pinned
# XERSCOPE_CADDY_IMAGE=<docker-hub-login>/xerscope-caddy:sha-<short>   # optional: the same for Caddy (docs/deploy.md §8)
# XERSCOPE_MEM_LIMIT=2g              # optional: the app's memory cap; about 1 GB per 40 MB export loaded (docs/deploy.md §7)
# XERSCOPE_QUERY_URL=https://172.29.0.20:8443  # optional: the Gantt Ask field asks the `llm` service at its fixed address, over TLS (profile ai, docs/deploy.md §10)
# XERSCOPE_LLM_KEY=<random>            # with it: the key the model requires; openssl rand -hex 24; the app sends it as XERSCOPE_QUERY_KEY
# XERSCOPE_MODELS=../models           # optional: folder holding the GGUF model the `llm` service loads
# XERSCOPE_LLM_MODEL=model.gguf       # optional: that file's name
# XERSCOPE_LLM_MEM_LIMIT=3g           # optional: the `llm` service's memory cap
