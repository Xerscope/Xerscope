# Behind Tailscale Funnel: TLS is terminated by tailscaled, Caddy only authenticates and
# proxies, on a port that exists solely inside the shared container network namespace.
# XERSCOPE_PATH is the secret URL prefix (no slashes): the app lives at /<prefix>/, every
# other path answers 404 before authentication. Scanners find every *.ts.net name within
# seconds from the public certificate logs; the prefix keeps them off the login prompt.
# rate_limit is not in the stock caddy image: this file runs on deploy/caddy/Dockerfile's.
#
# The logs keep what a review needs (path, status, visitor IP) and drop what a reader of
# them could reuse: the prefix becomes "<prefix>" wherever the URL appears, Streamlit's
# XSRF token and session id (the WebSocket subprotocol) are deleted, and so is the name of
# a downloaded file (the tables export names it after the project code).
{
    admin off
    auto_https off
    default_bind 127.0.0.1
    log {                                       # default logger: proxy errors (http.log.error.*) print the
        format filter {                         # request too; the site's log block filters access logs only
            wrap json
            request>uri regexp {$XERSCOPE_PATH} <prefix>
            request>headers>Referer regexp {$XERSCOPE_PATH} <prefix>
            request>headers>Sec-Websocket-Protocol delete
        }
    }
    servers {
        trusted_proxies static 127.0.0.1/32     # tailscaled proxies from loopback: log the visitor's IP
    }
}

:8080 {   # no host here: a host in the site address also filters the Host header
    header {                             # every response, 404 and 401 included
        Referrer-Policy no-referrer      # a link the page opens never carries the URL, i.e. the secret prefix
        X-Content-Type-Options nosniff   # a response is read as the type it declares, never guessed
        Content-Security-Policy "frame-ancestors 'self'"   # no other site can frame the app (clickjacking)
        Strict-Transport-Security "max-age=31536000"   # the browser never tries the name over plain HTTP
        Permissions-Policy "camera=(), microphone=(), geolocation=()"   # the app uses none of them
    }
    header -Server   # neither Caddy nor uvicorn names itself; a deletion is deferred, so it stays out of
                     # the block above, which must also reach the 401 (an error, where deferred ops do not run)
    redir /{$XERSCOPE_PATH} /{$XERSCOPE_PATH}/ 308   # the page's relative asset URLs need the trailing slash
    handle_path /{$XERSCOPE_PATH}/* {              # strips the prefix: Streamlit keeps serving "/"
        rate_limit {                     # runs before basic_auth (the module's directive order): a client over
            zone per_visitor {           # the limit gets 429 without a bcrypt run on the NAS's CPU
                key {client_ip}          # the visitor (trusted_proxies), not tailscaled's 127.0.0.1
                ipv6_prefix 64           # one bucket per IPv6 /64, which a single client can cycle through
                events 120               # every request counts, not only wrong passwords: a page load is
                window 1m                # about ten, a burst of downloads fifteen
            }
        }
        basic_auth {
            {$XERSCOPE_USER} {$XERSCOPE_PASSWORD_HASH}
        }
        @download path /media/*          # st.download_button files: schedule data, never kept on the visitor's disk
        header @download >Cache-Control no-store   # ">": applied after the upstream's own headers
        reverse_proxy app:8501    # network alias: "xerscope" is tailscale's hostname here
    }
    handle {
        respond 404
    }
    log {
        output stdout
        format filter {
            wrap console
            request>uri regexp {$XERSCOPE_PATH} <prefix>               # the request line holds the secret prefix
            request>headers>Referer regexp {$XERSCOPE_PATH} <prefix>   # so does the Referer
            resp_headers>Location regexp {$XERSCOPE_PATH} <prefix>     # and the redirect to the trailing slash
            request>headers>Sec-Websocket-Protocol delete   # Streamlit's XSRF token and session id
            resp_headers>Content-Disposition delete         # the export's file name carries the project code
        }
    }
}
