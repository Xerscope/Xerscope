# deploy/compose.yaml: copy to .env next to it, on a PC as on the NAS (Container Manager reads it too)
TS_AUTHKEY=tskey-auth-...            # Tailscale admin > Settings > Keys: single-use, tag:xerscope
XERSCOPE_USER=<login>
XERSCOPE_PASSWORD_HASH='$2a$14$...'   # quotes keep the $ signs; docker run --rm caddy:2.11.6 caddy hash-password --plaintext '...'
XERSCOPE_PATH=<random>               # openssl rand -hex 12; the app answers at /<random>/ only
XERSCOPE_EXPORTS=../exports          # NAS: /volume1/<shared-folder>
