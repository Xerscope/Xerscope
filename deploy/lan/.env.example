# deploy/lan/compose.yaml: copy to .env next to it (Container Manager reads it too)
XERSCOPE_LAN_IP=<nas-lan-ip>         # the NAS's own address on the LAN: the port is bound to it, the app answers at https://<nas-lan-ip>:8443
XERSCOPE_IMAGE=xerscope:custom       # local tags, loaded with docker load (docs/deploy-lan.md); never pulled
XERSCOPE_CADDY_IMAGE=xerscope-caddy:custom
XERSCOPE_USER=<login>
XERSCOPE_PASSWORD_HASH='$2a$10$...'   # quotes keep the $ signs; docker run --rm -it xerscope-caddy:custom caddy hash-password --algorithm bcrypt --bcrypt-cost 10
XERSCOPE_SESSION=<random>             # openssl rand -hex 32; letters and digits only. A new value signs every visitor out
XERSCOPE_EXPORTS=/volume1/<shared-folder>   # readable by the XERSCOPE_UID account only
# XERSCOPE_LAN_PORT=8443             # optional: the port on the NAS
# XERSCOPE_UID=<uid>                 # NAS: id <dedicated DSM account>; default 65532
# XERSCOPE_GID=<gid>
# XERSCOPE_MEM_LIMIT=2g              # the app's other optional variables: deploy/.env.example
# XERSCOPE_LEXICON_DIR=/volume1/docker/xerscope/lexicon
